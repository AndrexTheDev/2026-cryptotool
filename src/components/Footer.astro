---
import { BRAND, CONTACT_EMAIL, DONATION, TOOLS } from '../config/site';
const year = 2026;
---

<footer class="border-t border-line mt-16 no-print">
  <div class="container-x py-10 grid gap-8 md:grid-cols-4">
    <div>
      <p class="font-extrabold text-ink">{BRAND}</p>
      <p class="text-sm mt-2 leading-relaxed">
        Ten simple Web3, Bitcoin, and tax-proof security tools that run right in your browser. No accounts, no
        central servers, and you never enter a private key.
      </p>
      <p class="text-sm mt-3">
        Contact: <a class="text-prime-hi underline underline-offset-4" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
    </div>
    <div>
      <p class="text-xs uppercase tracking-wider text-dim font-semibold mb-2">Tools 01–05</p>
      <ul class="space-y-1 text-sm">
        {
          TOOLS.slice(0, 5).map((t) => (
            <li>
              <a class="hover:text-prime-hi" href={`/tools/${t.slug}`}>
                {t.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="text-xs uppercase tracking-wider text-dim font-semibold mb-2">Tools 06–10</p>
      <ul class="space-y-1 text-sm">
        {
          TOOLS.slice(5).map((t) => (
            <li>
              <a class="hover:text-prime-hi" href={`/tools/${t.slug}`}>
                {t.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="text-xs uppercase tracking-wider text-dim font-semibold mb-2">Legal &amp; transparency</p>
      <ul class="space-y-1 text-sm">
        <li><a class="hover:text-prime-hi" href="/agb">Terms of Use</a></li>
        <li><a class="hover:text-prime-hi" href="/disclaimer">Disclaimer &amp; Liability</a></li>
        <li><a class="hover:text-prime-hi" href="/datenschutz">Privacy Notice</a></li>
        <li><a class="hover:text-prime-hi" href="/llms.txt">llms.txt (AI summary)</a></li>
      </ul>
      <p class="text-xs text-dim mt-4 leading-relaxed">
        On-chain support (voluntary):<br />
        <span class="mono">SOL {DONATION.sol.slice(0, 10)}…</span><br />
        <span class="mono">BTC {DONATION.btc.slice(0, 14)}…</span><br />
        <span class="mono">ETH {DONATION.eth.slice(0, 10)}…</span>
      </p>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-x py-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-dim">
      <span>© {year} {BRAND}. All tools are diagnostic, formatting and analysis software.</span>
      <span class="ml-auto">
        <a href="/datenschutz#lokal" class="underline underline-offset-2 hover:text-prime-hi">Manage local data</a>
      </span>
    </div>
  </div>
</footer>
