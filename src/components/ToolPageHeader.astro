---
import { CATEGORY_LABEL, type ToolDef } from '../config/site';

interface Props {
  tool: ToolDef;
}
const { tool } = Astro.props;
---

<div class="border-b border-line bg-gradient-to-b from-graphite/60 to-transparent">
  <div class="container-x py-8">
    <nav class="text-xs text-dim mb-3" aria-label="Breadcrumb">
      <a href="/" class="hover:text-prime-hi">All tools</a>
      <span class="mx-1.5">/</span>
      <span>{CATEGORY_LABEL[tool.category]}</span>
      <span class="mx-1.5">/</span>
      <span class="text-body">{tool.name}</span>
    </nav>
    <div class="flex flex-wrap items-center gap-3">
      <span class="mono text-sm text-dim">{String(tool.id).padStart(2, '0')}</span>
      <h1 class="text-2xl sm:text-3xl">{tool.name}</h1>
      <span class="badge badge-amber hidden sm:inline-flex">Runs in your browser</span>
      <span class="badge badge-green hidden sm:inline-flex">No private keys needed</span>
    </div>
    <p class="text-lg text-ink font-medium mt-2 max-w-3xl">{tool.tagline}</p>

    <div class="mt-4 grid md:grid-cols-2 gap-3 max-w-4xl text-sm">
      <div class="card p-4">
        <div class="text-xs font-semibold uppercase tracking-wider text-prime-hi">In plain English</div>
        <p class="text-body mt-1.5 leading-relaxed">{tool.plainSummary}</p>
      </div>
      <div class="card p-4">
        <div class="text-xs font-semibold uppercase tracking-wider text-gold-hi">Real-world example</div>
        <p class="text-body mt-1.5 leading-relaxed">{tool.example}</p>
      </div>
    </div>

    <div class="mt-3 grid sm:grid-cols-3 gap-3 max-w-4xl text-sm">
      <div class="kpi">
        <div class="kpi-l">Step 1 · Enter</div>
        <div class="text-ink mt-1">Paste an address or data — or click “Load demo” to try it first</div>
      </div>
      <div class="kpi">
        <div class="kpi-l">Step 2 · Check</div>
        <div class="text-ink mt-1">Click the green check button to run the test locally</div>
      </div>
      <div class="kpi">
        <div class="kpi-l">Step 3 · Result</div>
        <div class="text-ink mt-1">Read the green/yellow/red traffic light and export if needed</div>
      </div>
    </div>
  </div>
</div>
