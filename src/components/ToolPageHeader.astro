---
import { CATEGORY_LABEL, type ToolDef } from '../config/site';

interface Props {
  tool: ToolDef;
}
const { tool } = Astro.props;
---

<div class="border-b border-line bg-gradient-to-b from-graphite/60 to-transparent">
  <div class="container-x py-8">
    <nav class="text-xs text-dim mb-3" aria-label="Breadcrumb">
      <a href="/" class="hover:text-prime-hi">Suite</a>
      <span class="mx-1.5">/</span>
      <span>{CATEGORY_LABEL[tool.category]}</span>
      <span class="mx-1.5">/</span>
      <span class="text-body">{tool.name}</span>
    </nav>
    <div class="flex flex-wrap items-center gap-3">
      <span class="mono text-sm text-dim">{String(tool.id).padStart(2, '0')}</span>
      <h1 class="text-2xl sm:text-3xl">{tool.name}</h1>
      <span class="badge badge-amber hidden sm:inline-flex">100 % Browser</span>
      <span class="badge badge-green hidden sm:inline-flex">Keine Keys</span>
    </div>
    <p class="text-lg text-body mt-2 max-w-3xl">{tool.tagline}</p>
    <div class="mt-4 grid sm:grid-cols-3 gap-3 max-w-4xl text-sm">
      <div class="kpi">
        <div class="kpi-l">Eingeben</div>
        <div class="text-ink mt-1">1 — Adresse oder Rohdaten einfügen / Demo laden</div>
      </div>
      <div class="kpi">
        <div class="kpi-l">Prüfen</div>
        <div class="text-ink mt-1">2 — Ein Klick auf den grünen Prüf-Button</div>
      </div>
      <div class="kpi">
        <div class="kpi-l">Verstehen</div>
        <div class="text-ink mt-1">3 — Ampel-Status, Kennzahlen, Export</div>
      </div>
    </div>
  </div>
</div>
