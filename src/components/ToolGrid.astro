---
import { TOOLS, CATEGORY_LABEL, type Category } from '../config/site';

const filters: { id: Category | 'all'; label: string }[] = [
  { id: 'all', label: 'All 10 tools' },
  { id: 'smart-account', label: CATEGORY_LABEL['smart-account'] },
  { id: 'bitcoin-compliance', label: CATEGORY_LABEL['bitcoin-compliance'] },
  { id: 'agents-intents-privacy', label: CATEGORY_LABEL['agents-intents-privacy'] },
];

function href(slug: string) {
  // base-aware, so local builds and subdirectory deployments resolve correctly.
  const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
  return `${base}tools/${slug}`;
}
---

<div class="flex flex-wrap gap-2 mb-8 mt-4" role="tablist" aria-label="Filter categories">
  {filters.map((f, i) => (
    <button
      class={`filter-btn btn btn-sm ${i === 0 ? 'btn-primary' : 'btn-ghost'}`}
      data-filter={f.id}
      role="tab"
      aria-selected={i === 0 ? 'true' : 'false'}
    >
      {f.label}
    </button>
  ))}
</div>

<div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-5">
  {TOOLS.map((t) => (
    <a href={href(t.slug)} data-astro-prefetch="hover" class="tool-card card card-hover p-5 group flex flex-col justify-between" data-cat={t.category}>
      <div>
        <div class="flex items-start justify-between gap-3">
          <h3 class="font-bold text-base leading-snug group-hover:text-prime-hi transition-colors">{t.name}</h3>
          <span class="text-[10px] font-bold mono text-dim border border-line rounded px-1.5 py-0.5 shrink-0">
            {String(t.id).padStart(2, '0')}
          </span>
        </div>
        <p class="text-sm font-medium text-ink mt-2 leading-snug">{t.tagline}</p>
        <p class="text-xs text-dim mt-2 leading-relaxed">{t.plainSummary}</p>
        <div class="mt-3 rounded-lg border border-line bg-obsidian/70 px-3 py-2 text-xs text-body leading-relaxed">
          <span class="font-semibold text-gold-hi">Example:</span> {t.example}
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-line/60">
        <div class="flex flex-wrap items-center gap-2 text-xs text-dim">
          <span class="badge badge-green">{CATEGORY_LABEL[t.category]}</span>
          <span class="mono">{t.timeSaved}</span>
        </div>
        <span class="inline-flex items-center gap-1 text-prime-hi text-sm mt-3 font-medium">
          Open tool <span aria-hidden="true">→</span>
        </span>
      </div>
    </a>
  ))}
</div>

<script>
  const btns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.tool-card');
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      btns.forEach((x) => {
        x.classList.remove('btn-primary');
        x.classList.add('btn-ghost');
        x.setAttribute('aria-selected', 'false');
      });
      b.classList.add('btn-primary');
      b.classList.remove('btn-ghost');
      b.setAttribute('aria-selected', 'true');
      const f = b.getAttribute('data-filter');
      cards.forEach((c) => {
        const show = f === 'all' || c.getAttribute('data-cat') === f;
        c.style.display = show ? '' : 'none';
      });
    }),
  );
</script>
