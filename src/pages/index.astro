---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND, SITE_URL, CONTACT_EMAIL, TOOLS } from '../config/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: `${BRAND} — Web3 Security & Forensics Suite`,
    url: SITE_URL,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Web3 Security & Forensics Suite',
    applicationCategory: 'SecurityApplication',
    operatingSystem: 'Web Browser',
    url: SITE_URL,
    author: { '@type': 'Person', name: 'AndrexTheDev', email: CONTACT_EMAIL },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'AndrexTheDev',
    email: CONTACT_EMAIL,
  },
];
---

<BaseLayout
  title="Forensische Web3-Sicherheit direkt im Browser | AndrexTheDev"
  description="Zehn forensische Web3-, Bitcoin- und Compliance-Werkzeuge — lokal im Browser, ohne Konto, ohne Weitergabe privater Schlüssel. Smart-Account-Audits, DAC8-Nachweise, Intent-Dekodierung."
  path="/"
  jsonLd={jsonLd}
>
  <section class="container-x py-10">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-ink max-w-3xl">
      Forensische Web3-Sicherheit, Smart-Account-Audits &amp; kryptografische Nachweise — direkt in Ihrem Browser
    </h1>
    <p class="mt-4 text-lg max-w-2xl">
      Verifizierte Diagnose vor der Signatur, lückenlose Steuer- und Erbfall-Prüfung, Schutz vor Account-Abstraction-
      und KI-Agenten-Risiken — sofort einsatzbereit, ohne Kontoeröffnung und ohne Weitergabe privater Schlüssel.
    </p>
    <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        TOOLS.map((t) => (
          <a href={`/tools/${t.slug}`} class="card card-hover p-5 block">
            <div class="flex items-center gap-2">
              <span class="mono text-xs text-dim">{String(t.id).padStart(2, '0')}</span>
              <h2 class="text-base font-bold text-ink">{t.name}</h2>
            </div>
            <p class="text-sm mt-2">{t.tagline}</p>
            <p class="text-xs text-prime-hi mt-3">Modul öffnen →</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
