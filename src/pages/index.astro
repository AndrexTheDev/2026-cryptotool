---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolGrid from '../components/ToolGrid.astro';

const faq = [
  {
    q: 'Do I have to pay or sign up?',
    a: 'No. There are no prices, no subscriptions, and no accounts. Every check runs directly in your browser. If you find the tools helpful, you can optionally send a voluntary donation via SOL, BTC, or ETH—every feature works identically either way.',
  },
  {
    q: 'Where does my data go?',
    a: 'All calculations run locally in your own browser. There is no StackAutopsy server collecting your inputs or wallet addresses. When a tool checks live blockchain data, your browser talks directly to public blockchain reader nodes (and you can set your own node in the Network menu).',
  },
  {
    q: 'Does this replace a lawyer or tax advisor?',
    a: 'No. The suite gives you clear technical facts and downloadable reports, not legal or tax advice. For example, DAC8-SelfProof builds a helpful proof document, which you can hand to your tax advisor or exchange.',
  },
  {
    q: 'Can I use the tools offline without internet?',
    a: 'Yes. Every tool has an offline mode where you can paste data or drop a file directly. Once the page is loaded, all core checks work without a server. Live blockchain comparisons will simply say “unavailable” instead of blocking you.',
  },
  {
    q: 'Do I ever need to enter a seed phrase or private key?',
    a: 'Never! You only ever paste public addresses, transaction IDs, or read-only data. In fact, the tools actively block seed phrases if someone tries to paste one by mistake.',
  },
];

const SITE_URL = import.meta.env.SITE ?? 'https://suite.andrexthe.dev';
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const siteLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'StackAutopsy — Web3 Security & Forensics Suite',
    url: SITE_URL,
    inLanguage: ['en'],
    author: { '@type': 'Person', name: 'AndrexTheDev', email: 'hippie.highho@gmail.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'AndrexTheDev',
    email: 'hippie.highho@gmail.com',
    url: SITE_URL,
    jobTitle: 'Independent Web3 Security Tooling',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'StackAutopsy — Web3 Security & Forensics Suite',
    applicationCategory: 'SecurityApplication',
    operatingSystem: 'Web Browser',
    url: SITE_URL,
    description: 'Ten simple browser-based crypto, Bitcoin and tax-proof security tools — no signup, no private keys.',
    author: { '@type': 'Person', name: 'AndrexTheDev', email: 'hippie.highho@gmail.com' },
    isAccessibleForFree: true,
    usageInfo: 'No accounts, no prices; voluntary on-chain support.',
  },
];

const comparisons = [
  {
    before: 'You do not know if hidden code is attached to your Ethereum wallet',
    after: '7702-SlotGuard shows any attached code in seconds and builds an undo file',
  },
  {
    before: 'A wallet update looks like unreadable hex numbers before you sign',
    after: 'STVA-UpgradeDiff translates the update and shows what actually changes',
  },
  {
    before: 'An AI payment app uses outdated libraries or leaves spending wide open',
    after: 'x402-PaywallGuard flags known bugs and missing spending limits right away',
  },
  {
    before: 'A cross-chain swap costs more than expected or gets stuck past its deadline',
    after: 'IntentLens-7683 reveals the hidden fee spread and prepares refund data',
  },
  {
    before: 'A DeFi website might be loading altered scripts to trick your wallet',
    after: 'BundleWatch-ENS compares live website files against the official ENS release',
  },
];

const pillars = [
  {
    title: 'Runs 100% in your browser',
    text: 'All checks run locally on your own device. Nothing is sent to a StackAutopsy server.',
    icon: 'M12 3l8 4v5c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V7l8-4z',
  },
  {
    title: 'No account, no tracking',
    text: 'No login, no analytics, and no tracking cookies. Each tool only loads when you open it.',
    icon: 'M9 12l2 2 4-5M12 3a9 9 0 100 18 9 9 0 000-18z',
  },
  {
    title: 'Clear, repeatable math',
    text: 'Every green, yellow, or red warning follows fixed, documented rules—never secret black-box scores.',
    icon: 'M4 4h16v4H4zM4 10h10v4H4zM4 16h16v4H4z',
  },
  {
    title: 'Open source & verifiable',
    text: 'Every tool is open for inspection and follows public Ethereum, Bitcoin, and ENS standards.',
    icon: 'M8 7l-5 5 5 5M16 7l5 5-5 5M13 4l-3 16',
  },
];

const steps = [
  { n: '01', title: 'Pick a tool', text: 'Choose what you want to check below—each tool includes a simple explanation and example.' },
  { n: '02', title: 'Paste data or try the demo', text: 'Enter a public address, transaction ID, or file—or click “Load demo” to test it safely first.' },
  { n: '03', title: 'Get a clear traffic light', text: 'Click the green check button to get a green, yellow, or red result plus an optional report export.' },
];
---

<BaseLayout shell="static"
  title="Web3 Security Toolkit 2026 — 10 easy browser tools"
  description="Ten easy-to-understand Web3, Bitcoin and tax-proof check tools: check wallets, updates, swaps, fees, passkeys and websites safely in your browser — no signup."
  path="/"
  jsonLd={[faqLd, ...siteLd]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_-10%,rgba(16,185,129,0.14),transparent)] pointer-events-none" />
    <div class="container-x relative py-16 sm:py-24 text-center">
      <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-prime-hi bg-prime-dim border border-mint/30 rounded-full px-4 py-1.5">
        10 simple tools · runs in your browser · live-verified · no signup
      </span>
      <h1 class="mt-6 text-4xl sm:text-6xl font-extrabold leading-[1.05] tracking-tight max-w-4xl mx-auto">
        Check crypto safety in plain English, <span class="text-transparent bg-clip-text bg-gradient-to-r from-prime to-prime-hi">before you sign</span>.
      </h1>
      <p class="mt-5 text-base sm:text-lg text-dim max-w-2xl mx-auto">
        Spot hidden wallet takeovers, decode confusing updates, prove wallet ownership for taxes, test Bitcoin inheritance fees, and verify DeFi websites—all locally in your browser with built-in demo examples. Never enter a private key or seed phrase.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="#tools" class="btn btn-primary px-6 py-3 text-base">Browse all 10 tools</a>
        <a href="#support" class="btn btn-ghost px-6 py-3 text-base">♥ Support the project</a>
      </div>
      <div class="mt-10 inline-flex items-center gap-3 text-sm text-dim bg-surface border border-line rounded-full px-5 py-2.5">
        <span class="w-2 h-2 rounded-full bg-prime animate-pulse" />
        Last module update: <time datetime="2026-11-15" class="text-ink font-medium">15 November 2026</time>
      </div>
    </div>
  </section>

  <!-- Threat landscape -->
  <section class="border-y border-line bg-surface/50">
    <div class="container-x py-14">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl font-bold">Why check before you click “Confirm”?</h2>
        <p class="text-dim mt-3 text-sm sm:text-base">
          In 2026, three everyday risks catch both beginners and pros off guard: <strong class="text-ink">hidden wallet permissions (EIP-7702)</strong> can silently drain funds later, <strong class="text-ink">AI payment apps (x402)</strong> can ship with unfixed bugs, and <strong class="text-ink">new tax rules (DAC8)</strong> ask for proof that your self-custody wallet is really yours. Each tool here turns complicated blockchain data into a clear green, yellow, or red check.
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4 mt-8">
        {[
          { k: '7702', t: 'Hidden wallet hijackers', d: 'One bad signature can attach a hidden drain script to your wallet. SlotGuard checks your address and helps you undo it.' },
          { k: 'x402', t: 'Leaky AI payment apps', d: 'Apps where AI agents pay automatically can leak funds if outdated. PaywallGuard spots known bugs and missing spending caps.' },
          { k: 'ENS', t: 'Tampered app websites', d: 'Hackers sometimes swap scripts on a DeFi website or ENS name. BundleWatch checks whether the live site matches the official release.' },
        ].map((c) => (
          <div class="card p-5">
            <span class="mono text-xs text-prime-hi font-bold">{c.k}</span>
            <h3 class="font-semibold mt-1.5">{c.t}</h3>
            <p class="text-sm text-dim mt-1.5">{c.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tool bento -->
  <section id="tools" class="container-x py-16">
    <div class="flex items-end justify-between mb-2">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold">All 10 tools—explained simply with examples</h2>
        <p class="text-dim text-sm mt-1">Filter by topic below. Every tool includes a one-click demo so you can try it safely right away.</p>
      </div>
      <a href="/llms.txt" class="hidden md:inline btn btn-ghost btn-sm mono text-xs">llms.txt</a>
    </div>
    <ToolGrid />
  </section>

  <!-- Before/After -->
  <section class="border-y border-line bg-surface/50">
    <div class="container-x py-14">
      <h2 class="text-2xl sm:text-3xl font-bold">What changes when you check first</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="table-x">
          <thead><tr><th class="w-1/2">Without checking</th><th>With StackAutopsy</th></tr></thead>
          <tbody>
            {comparisons.map((c) => (
              <tr>
                <td class="text-sm text-dim">{c.before}</td>
                <td class="text-sm"><span class="badge badge-green mr-2">with check</span>{c.after}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Flow -->
  <section class="container-x py-14">
    <h2 class="text-2xl sm:text-3xl font-bold">How it works in 3 simple steps</h2>
    <div class="grid sm:grid-cols-3 gap-4 mt-6">
      {steps.map((s) => (
        <div class="card p-5">
          <span class="mono text-2xl font-extrabold text-prime-hi">{s.n}</span>
          <h3 class="font-semibold mt-2">{s.title}</h3>
          <p class="text-sm text-dim mt-1">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Trust pillars -->
  <section class="border-y border-line bg-surface/50">
    <div class="container-x py-14">
      <h2 class="text-2xl sm:text-3xl font-bold">Built for privacy &amp; clarity</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
        {pillars.map((p) => (
          <div class="card p-5">
            <svg class="w-7 h-7 text-prime-hi" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d={p.icon} /></svg>
            <h3 class="font-semibold mt-3">{p.title}</h3>
            <p class="text-sm text-dim mt-1.5">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-x py-14 max-w-3xl">
    <h2 class="text-2xl sm:text-3xl font-bold">Common questions (FAQ)</h2>
    <div class="mt-6 space-y-3">
      {faq.map((f) => (
        <details class="acc">
          <summary class="font-medium">{f.q}</summary>
          <div class="acc-body text-sm text-dim">{f.a}</div>
        </details>
      ))}
    </div>
  </section>

  <!-- Support / donations -->
  <section id="support" class="border-t border-line bg-surface/50">
    <div class="container-x py-16 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold">Support independent security tools</h2>
      <p class="text-dim max-w-xl mx-auto mt-3 text-sm sm:text-base">
        Donations are <strong class="text-ink">100% voluntary</strong>: three public addresses, QR codes generated on your device, no paywalls.
      </p>
      <div class="flex flex-wrap justify-center gap-3 mt-7">
        <a href="/donate" class="btn btn-primary px-6 py-3">View donation addresses</a>
        <a href="/disclaimer" class="btn btn-ghost px-6 py-3">Read the disclaimer</a>
      </div>
    </div>
  </section>
</BaseLayout>
