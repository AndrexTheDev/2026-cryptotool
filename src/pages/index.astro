---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolGrid from '../components/ToolGrid.astro';

const faq = [
  {
    q: 'What does the suite cost?',
    a: 'The suite has no prices, subscriptions or accounts. Every analysis runs locally in your browser. If you want to support the work, you can voluntarily donate via SOL, BTC or an EVM address — with no influence on features.',
  },
  {
    q: 'Where is my data processed?',
    a: 'Exclusively in your browser: WebCrypto, workers and IndexedDB. There is no suite server that receives data. Live chain checks go directly from your browser to public read endpoints — you can configure your own — and pasted claims are automatically cross-checked against the chain.',
  },
  {
    q: 'Are the results legally binding?',
    a: 'No. The suite provides technical preliminary indicators and finding artifacts. It does not replace legal, tax or compliance advice. DAC8-SelfProof is expressly a preparatory information sheet, not a filing.',
  },
  {
    q: 'Can I use the tools offline?',
    a: 'Yes. Every tool has offline paths: manual inputs, dumps, files or signed artifacts. Once loaded, the page needs no server roundtrip for its core functions; live cross-checks then simply report “unavailable” instead of blocking you.',
  },
  {
    q: 'Why donations instead of a subscription?',
    a: 'Because security tools work best when they are accessible without coercion. Donations are voluntary, non-refundable and create no consideration.',
  },
];

const SITE_URL = import.meta.env.SITE ?? 'https://suite.andrexthe.dev';
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const siteLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'StackAutopsy — Web3 Security & Forensics Suite',
    url: SITE_URL,
    inLanguage: ['en'],
    author: { '@type': 'Person', name: 'AndrexTheDev', email: 'hippie.highho@gmail.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'AndrexTheDev',
    email: 'hippie.highho@gmail.com',
    url: SITE_URL,
    jobTitle: 'Independent Web3 Security Tooling',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'StackAutopsy — Web3 Security & Forensics Suite',
    applicationCategory: 'SecurityApplication',
    operatingSystem: 'Web Browser',
    url: SITE_URL,
    description: 'Ten local Web3, Bitcoin and compliance tools — fully client-side, no signup.',
    author: { '@type': 'Person', name: 'AndrexTheDev', email: 'hippie.highho@gmail.com' },
    isAccessibleForFree: true,
    usageInfo: 'No accounts, no prices; voluntary on-chain support.',
  },
];

const comparisons = [
  { before: 'Delegations control unknown, unlimited targets', after: '7702-SlotGuard lists delegate, scope and risk in minutes' },
  { before: 'Proxy upgrades are signed blindly', after: 'STVA-UpgradeDiff shows storage collisions and initializer traps beforehand' },
  { before: 'x402 middleware outdated, replay gate unnoticed', after: 'x402-PaywallGuard flags affected versions and SIWx misconfiguration' },
  { before: 'Intent spreads unclear, deadlines missed', after: 'IntentLens-7683 computes fill windows and spread deterministically' },
  { before: 'Live dApp silently differs from the release', after: 'BundleWatch-ENS reconciles script hashes with the ENS release' },
];

const pillars = [
  {
    title: '100 % local & client-side',
    text: 'Computation with WebCrypto and workers in the browser. There is no data upload to an operator server — your browser is the runtime.',
    icon: 'M12 3l8 4v5c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V7l8-4z',
  },
  {
    title: 'No signup, no tracking',
    text: 'No accounts, no analytics, no cookies. The page lazy-loads tool code only on demand — the homepage contains not a single crypto import.',
    icon: 'M9 12l2 2 4-5M12 3a9 9 0 100 18 9 9 0 000-18z',
  },
  {
    title: 'Deterministic math',
    text: 'All risk scores and thresholds are documented fixed in the code, reproducible and exportable. No black-box scoring services.',
    icon: 'M4 4h16v4H4zM4 10h10v4H4zM4 16h16v4H4z',
  },
  {
    title: 'Open source & auditable',
    text: 'Every page links to the module source code. Fresh builds are reproducible, the hash standards (EIP-191, BIP-322, EIP-1577) are public.',
    icon: 'M8 7l-5 5 5 5M16 7l5 5-5 5M13 4l-3 16',
  },
];

const steps = [
  { n: '01', title: 'Open a module', text: 'Pick a tile — the tool JavaScript loads only now, isolated from the rest of the page.' },
  { n: '02', title: 'Choose an input', text: 'Address, JSON, calldata, log file or demo scenario. Offline mode available everywhere.' },
  { n: '03', title: 'Start the check', text: 'One click starts the analysis; the result appears as a traffic light, KPIs, details and export.' },
];
---

<BaseLayout shell="static"
  title="Web3 Security Toolkit 2026 — 10 local audit tools"
  description="Ten browser-local, live-verified Web3, Bitcoin and compliance tools: EIP-7702, DAC8, BIP-322, passkeys, x402, intents, privacy — in the browser, no signup."
  path="/"
  jsonLd={[faqLd, ...siteLd]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_-10%,rgba(16,185,129,0.14),transparent)] pointer-events-none" />
    <div class="container-x relative py-16 sm:py-24 text-center">
      <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-prime-hi bg-prime-dim border border-mint/30 rounded-full px-4 py-1.5">
        10 modules · browser-local · live-verified · no signup
      </span>
      <h1 class="mt-6 text-4xl sm:text-6xl font-extrabold leading-[1.05] tracking-tight max-w-4xl mx-auto">
        Verify Web3 security, <span class="text-transparent bg-clip-text bg-gradient-to-r from-prime to-prime-hi">before you sign</span>.
      </h1>
      <p class="mt-5 text-base sm:text-lg text-dim max-w-2xl mx-auto">
        EIP-7702 delegations, proxy upgrades, DAC8 findings, BIP-322 proofs, x402 middleware, intents, privacy and more — computed locally in your browser and cross-checked live against the chains. Nothing ever passes through an operator server.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="#tools" class="btn btn-primary px-6 py-3 text-base">Explore tools</a>
        <a href="#support" class="btn btn-ghost px-6 py-3 text-base">♥ Support the project</a>
      </div>
      <div class="mt-10 inline-flex items-center gap-3 text-sm text-dim bg-surface border border-line rounded-full px-5 py-2.5">
        <span class="w-2 h-2 rounded-full bg-prime animate-pulse" />
        Last module update: <time datetime="2026-11-15" class="text-ink font-medium">15 November 2026</time>
      </div>
    </div>
  </section>

  <!-- Threat landscape -->
  <section class="border-y border-line bg-surface/50">
    <div class="container-x py-14">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl font-bold">The 2026 threat landscape</h2>
        <p class="text-dim mt-3 text-sm sm:text-base">
          Three developments make ad-hoc checks inadequate: <strong class="text-ink">EIP-7702 delegations</strong> give smart contracts key power over EOAs, <strong class="text-ink">x402 payment middleware</strong> spreads faster than audits, and <strong class="text-ink">DAC8/CARF reporting duties</strong> demand documented self-disclosures. This suite checks technically, deterministically and locally — without any account being created anywhere.
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4 mt-8">
        {[
          { k: '7702', t: 'Delegation hijacks', d: 'Unchecked delegate addresses can take over entire wallets. SlotGuard shows every delegate and its scope.' },
          { k: 'x402', t: 'Paywall middleware traps', d: 'Outdated x402 versions without replay protection or signature binding are an entry point. PaywallGuard detects them.' },
          { k: 'ENS', t: 'Bundle substitution', d: 'If the ENS record switches, the dApp suddenly loads foreign scripts. BundleWatch compares hashes with the reference release.' },
        ].map((c) => (
          <div class="card p-5">
            <span class="mono text-xs text-prime-hi font-bold">{c.k}</span>
            <h3 class="font-semibold mt-1.5">{c.t}</h3>
            <p class="text-sm text-dim mt-1.5">{c.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tool bento -->
  <section id="tools" class="container-x py-16">
    <div class="flex items-end justify-between mb-2">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold">Ten tools, one click away</h2>
        <p class="text-dim text-sm mt-1">Filter: pick a category — tool code loads only after opening.</p>
      </div>
      <a href="/llms.txt" class="hidden md:inline btn btn-ghost btn-sm mono text-xs">llms.txt</a>
    </div>
    <ToolGrid />
  </section>

  <!-- Before/After -->
  <section class="border-y border-line bg-surface/50">
    <div class="container-x py-14">
      <h2 class="text-2xl sm:text-3xl font-bold">Before / After</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="table-x">
          <thead><tr><th class="w-1/2">Without checking</th><th>With the Web3 Security Toolkit</th></tr></thead>
          <tbody>
            {comparisons.map((c) => (
              <tr>
                <td class="text-sm text-dim">{c.before}</td>
                <td class="text-sm"><span class="badge badge-green mr-2">after</span>{c.after}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Flow -->
  <section class="container-x py-14">
    <h2 class="text-2xl sm:text-3xl font-bold">Three steps to a finding</h2>
    <div class="grid sm:grid-cols-3 gap-4 mt-6">
      {steps.map((s) => (
        <div class="card p-5">
          <span class="mono text-2xl font-extrabold text-prime-hi">{s.n}</span>
          <h3 class="font-semibold mt-2">{s.title}</h3>
          <p class="text-sm text-dim mt-1">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Trust pillars -->
  <section class="border-y border-line bg-surface/50">
    <div class="container-x py-14">
      <h2 class="text-2xl sm:text-3xl font-bold">Trust through architecture</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
        {pillars.map((p) => (
          <div class="card p-5">
            <svg class="w-7 h-7 text-prime-hi" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d={p.icon} /></svg>
            <h3 class="font-semibold mt-3">{p.title}</h3>
            <p class="text-sm text-dim mt-1.5">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-x py-14 max-w-3xl">
    <h2 class="text-2xl sm:text-3xl font-bold">Frequently asked questions</h2>
    <div class="mt-6 space-y-3">
      {faq.map((f) => (
        <details class="acc">
          <summary class="font-medium">{f.q}</summary>
          <div class="acc-body text-sm text-dim">{f.a}</div>
        </details>
      ))}
    </div>
  </section>

  <!-- Support / donations -->
  <section id="support" class="border-t border-line bg-surface/50">
    <div class="container-x py-16 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold">Support independent Web3 security</h2>
      <p class="text-dim max-w-xl mx-auto mt-3 text-sm sm:text-base">
        Donations are <strong class="text-ink">voluntary</strong> and transparent at all times: three addresses, QR codes generated locally, no consideration.
      </p>
      <div class="flex flex-wrap justify-center gap-3 mt-7">
        <a href="/donate" class="btn btn-primary px-6 py-3">View donation addresses</a>
        <a href="/disclaimer" class="btn btn-ghost px-6 py-3">Read the disclaimer</a>
      </div>
    </div>
  </section>
</BaseLayout>
