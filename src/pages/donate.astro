---
import BaseLayout from '../layouts/BaseLayout.astro';
import DonationPage from '../components/react/DonationPage';
import { SITE_URL } from '../config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Support StackAutopsy',
  url: `${SITE_URL}/donate`,
  description: 'Voluntary on-chain support for the suite: SOL, BTC or EVM address. QR codes generated locally.',
};
---

<BaseLayout
  title="Support StackAutopsy — voluntary on-chain donations"
  description="Voluntary on-chain support: SOL, BTC and EVM addresses with locally generated QR codes (BIP-21, Solana Pay, EIP-681). No consideration."
  path="/donate"
  jsonLd={jsonLd}
>
  <div class="container-x py-12 max-w-3xl">
    <h1 class="text-2xl sm:text-3xl font-bold">Support StackAutopsy</h1>
    <p class="text-dim mt-2 text-sm sm:text-base">
      All tools work without accounts, tracking, or paywalls. If you want to support this independent project, you
      can send a voluntary donation to one of the addresses below.
    </p>
    <div class="mt-6">
      <DonationPage client:only="react" />
    </div>
    <p class="text-xs text-dim mt-6">
      Alternatively as a modal in every tool view: <em>Support / Donate</em> in the header.
    </p>
  </div>
</BaseLayout>
