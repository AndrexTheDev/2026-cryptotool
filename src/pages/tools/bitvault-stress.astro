---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
import BitVaultStress from '../../components/tools/BitVaultStress';
import { SITE_URL, toolBySlug } from '../../config/site';

const tool = toolBySlug('bitvault-stress')!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'Web Browser',
  url: `${SITE_URL}/tools/${tool.slug}`,
  description: tool.seoDesc,
  author: { '@type': 'Person', name: 'AndrexTheDev', email: 'hippie.highho@gmail.com' },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Suite', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: tool.name, item: `${SITE_URL}/tools/${tool.slug}` },
  ],
};

---

<BaseLayout title={tool.seoTitle} description={tool.seoDesc} path={`/tools/${tool.slug}`} jsonLd={[jsonLd, breadcrumbLd]}>
  <ToolPageHeader tool={tool} />
  <div class="container-x py-8">
    <BitVaultStress client:only="react" />
    <noscript>
      <div class="card p-5 mt-4">
        This tool requires JavaScript — all logic runs exclusively locally in your
        browser (no server roundtrip). Enable JavaScript or use the documented
        offline paths (manual input after local execution) on a device with JavaScript.
      </div>
    </noscript>
  </div>
</BaseLayout>
