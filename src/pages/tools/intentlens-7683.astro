---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
import IntentLens7683 from '../../components/tools/IntentLens7683';
import { SITE_URL, toolBySlug } from '../../config/site';

const tool = toolBySlug('intentlens-7683')!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'Web Browser',
  url: `${SITE_URL}/tools/${tool.slug}`,
  description: tool.seoDesc,
  author: { '@type': 'Person', name: 'AndrexTheDev', email: 'hippie.highho@gmail.com' },
};
---

<BaseLayout title={tool.seoTitle} description={tool.seoDesc} path={`/tools/${tool.slug}`} jsonLd={jsonLd}>
  <ToolPageHeader tool={tool} />
  <div class="container-x py-8">
    <IntentLens7683 client:only="react" />
  </div>
</BaseLayout>
