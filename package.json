{
  "name": "stackautopsy",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "description": "StackAutopsy — Web3 Security & Forensics Suite: 10 client-side Web3/Bitcoin/compliance tools, fully local in the browser",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit-dist.mjs",
    "test:demos": "node --experimental-strip-types scripts/verify-demos.mjs",
    "verify": "npm run typecheck && npm run build && node scripts/audit-dist.mjs && npm run audit:deps && npm run test:demos",
    "audit:deps": "npm audit --omit=dev --audit-level=critical"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.5",
    "@bitcoinerlab/descriptors-scure": "3.2.1",
    "@bitcoinerlab/miniscript-policies": "1.1.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "age-encryption": "0.3.1",
    "astro": "^7.4.12",
    "bip322-js": "4.0.1",
    "buffer": "^6.0.3",
    "fflate": "0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "4.3.5",
    "uqr": "0.1.3",
    "viem": "^2.58.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5"
  },
  "license": "MIT"
}
